# Serveur MCP
CONTACT_HOST=127.0.0.1
CONTACT_PORT=8000
# Domaine public sans protocole. Conserver localhost pour les tests sur le VPS.
CONTACT_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,mcp-contact-me.tanguym.fr,mcp-contact-me.tanguym.fr:*
# Nécessaire uniquement pour des clients exécutés dans un navigateur.
CONTACT_ALLOWED_ORIGINS=http://localhost:*,https://portfolio-ia.tanguym.fr
CONTACT_TOKEN_REGISTRY_PATH=data/tokens.json
CONTACT_RATE_LIMIT_DB_PATH=data/rate_limits.db
CONTACT_AUDIT_LOG_PATH=data/audit.log
CONTACT_RATE_LIMIT_PER_MINUTE=5
CONTACT_RATE_LIMIT_PER_DAY=50

# E-mail SMTP
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURITY=starttls
CONTACT_SMTP_USERNAME=user@example.com
CONTACT_SMTP_PASSWORD=change-me
CONTACT_EMAIL_FROM=user@example.com
CONTACT_EMAIL_TO=user@example.com

# Telegram : token fourni par BotFather et identifiant du chat destinataire
CONTACT_TELEGRAM_BOT_TOKEN=change-me
CONTACT_TELEGRAM_CHAT_ID=change-me
